# Copy this file to .env ONCE, then paste your Swiss AI API key:
#
#     cp .env.example .env
#     $EDITOR .env
#
# .env is gitignored and must never be committed. Both run-openwebui.sh and
# run-opencode.sh read the key from it, so this is the only place to set it.
#
# Get a key from the CSCS / Swiss AI Services dashboard:
#     https://api.swissai.svc.cscs.ch/
#
SWISSAI_RESEARCH_API_KEY=
